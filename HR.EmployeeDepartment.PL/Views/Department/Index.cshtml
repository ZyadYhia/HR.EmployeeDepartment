
@{
    ViewData["Title"] = "Departments Page";
}
@model IEnumerable<Department>
@* @model Department *@

<h2>Departments</h2>

<a class="btn btn-primary my-4" asp-area="" asp-controller="Department" asp-action="Create">Create New Department</a>

<div class="text-center">
    @if(Model.Count() > 0)
    {
        <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Code</th>
                <th scope="col">Name</th>
                <th scope="col">View</th>
                <th scope="col">Edit</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td><a class="btn btn-warning" asp-area="" asp-controller="Department" asp-action="Details" asp-route-id="@item.Id">Details</a></td>
                    <td><a class="btn btn-success" asp-area="" asp-controller="Department" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                    <td><a class="btn btn-danger" asp-area="" asp-controller="Department" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
    }
    else
    {
       <div class="alert alert-warning" role="alert">
            No departments found.
        </div>
    }
    
</div>
