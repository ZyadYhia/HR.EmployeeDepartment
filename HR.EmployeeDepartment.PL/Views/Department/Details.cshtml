@model Department
@{
    ViewData["Title"] = "Department Page";
}
<div class="">
    <h1 class="display-4">Create New Department</h1>
    <div class="form-group">
        <label asp-for="Code" class="col-form-label"></label>
        <input asp-for="Code" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Name" class="col-form-label"></label>
        <input asp-for="Name" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="CreatedAt" class="col-form-label"></label>
        <input asp-for="CreatedAt" class="form-control" readonly />
    </div>
    <div class="mt-4">
        <a class="btn btn-warning" asp-controller="Department" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-secondary" asp-controller="Department" asp-action="Index">Cancel</a>
    </div>
</div>