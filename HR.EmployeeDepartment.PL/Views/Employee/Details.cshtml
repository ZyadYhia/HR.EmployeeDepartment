@model Employee
@{
    ViewData["Title"] = "Employee Details";
}

<h1 class="display-4">Employee Details</h1>

<div class="mb-3">
    <dl class="row">
        <dt class="col-sm-3">Id</dt><dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Age</dt><dd class="col-sm-9">@(Model.Age?.ToString() ?? "-")</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3">Salary</dt><dd class="col-sm-9">@Model.Salary.ToString("C")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        <dt class="col-sm-3">Hiring Date</dt><dd class="col-sm-9">@Model.HiringDate.ToString("d")</dd>
    </dl>
</div>

<a class="btn btn-success" asp-controller="Employee" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-secondary" asp-controller="Employee" asp-action="Index">Back to list</a>
<a class="btn btn-danger" asp-controller="Employee" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>