@model CreateEmployeeDto
@{
    ViewData["Title"] = "Create Employee";
}

<div class="">
    <h1 class="display-4">Create New Employee</h1>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="EmployeePartialView/_CreateEditPV" model="@Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Create</button>
            <a class="btn btn-secondary" asp-controller="Employee" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>