@using System.Linq
@{
    ViewData["Title"] = "Employees Page";
}
@model IEnumerable<Employee>

<h2>Employees</h2>

<a class="btn btn-primary my-4" asp-controller="Employee" asp-action="Create">Create New Employee</a>

<div class="text-center">
    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.First().Id)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Name)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Age)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Email)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Phone)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Salary)</th>
                        <th>@Html.DisplayNameFor(m => m.First().IsActive)</th>
                        <th>@Html.DisplayNameFor(m => m.First().HiringDate)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Department.Name)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@(item.Age?.ToString() ?? "-")</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@item.Salary.ToString("C")</td>
                            <td>@(item.IsActive ? "Active" : "Inactive")</td>
                            <td>@item.HiringDate.ToString("d")</td>
                            <td>@item.Department?.Name ?? "-"</td>
                            <td>
                                <a class="btn btn-warning btn-sm" asp-controller="Employee" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <a class="btn btn-success btn-sm" asp-controller="Employee" asp-action="Edit" asp-route-id="@item.Id">Edit</a>

                                <form asp-controller="Employee" asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this employee?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            No employees found.
        </div>
    }
</div>
